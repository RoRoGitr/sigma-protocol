# ============================================================
# Sigma Next.js SaaS Boilerplate — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Run `npm run setup` for an interactive setup wizard.
# ============================================================

# ------------------------------------------------------------
# Supabase
# Get these from: https://app.supabase.com → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# WARNING: Never expose this key in the browser — server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# Database (Drizzle ORM)
# Use the "Transaction" pooler connection string from Supabase
# Dashboard → Project Settings → Database → Connection Pooling
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------
# Stripe
# Get these from: https://dashboard.stripe.com/developers
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------
# OpenAI (AI SDK)
# Get from: https://platform.openai.com/api-keys
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ------------------------------------------------------------
# Resend (Transactional Email)
# Get from: https://resend.com/api-keys
# ------------------------------------------------------------
RESEND_API_KEY=re_...

# ------------------------------------------------------------
# PostHog (Product Analytics)
# Get from: https://app.posthog.com/project/settings
# ------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# Set to "true" to enable analytics (false in development)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------
# Public URL of your app (used for OG images, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Default credits granted to new users
NEXT_PUBLIC_DEFAULT_CREDITS=100
