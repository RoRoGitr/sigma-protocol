# ─────────────────────────────────────────────────────────────────────────────
# Fintech Trading Platform — Mobile Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file with real secrets.
#
# Variables prefixed with EXPO_PUBLIC_ are bundled into the JS bundle and
# visible to the client. Do NOT put secrets (private keys, service-role keys)
# in EXPO_PUBLIC_ variables.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Supabase ────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com and find these under:
# Project Settings → API → Project URL / anon (public) key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key


# ─── RevenueCat (Subscriptions) ──────────────────────────────────────────────
# Sign up at https://www.revenuecat.com and create a project.
# Find your API key under Project Settings → API Keys → Public app-specific key.
# Use the iOS key for iOS builds, Android key for Android builds.
# NOTE: This variable is NOT prefixed with EXPO_PUBLIC_ — it is read server-side
# or via a native module initializer before the JS bundle runs.
REVENUECAT_API_KEY=your-revenuecat-api-key


# ─── TradeLocker Broker OAuth ─────────────────────────────────────────────────
# Apply for API access at https://tradelocker.com/api
# These values identify your app in the OAuth flow.
EXPO_PUBLIC_TRADELOCKER_CLIENT_ID=your-tradelocker-client-id
# Must match the redirect URI registered with TradeLocker.
# Default deep-link scheme: trading-platform://broker/callback
EXPO_PUBLIC_TRADELOCKER_REDIRECT_URI=trading-platform://broker/callback


# ─── Expo Push Notifications ─────────────────────────────────────────────────
# Your Expo experience ID ties push notifications to your account.
# Format: @your-expo-username/your-app-slug  (from app.json → slug)
# Find it at https://expo.dev under your project overview.
EXPO_PUBLIC_EXPERIENCE_ID=@your-expo-username/trading-platform


# ─── Development / Mock Mode ─────────────────────────────────────────────────
# Set to "true" to enable mock data without live broker/Supabase connections.
# Automatically enabled in __DEV__ builds regardless of this value.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_MOCK_MODE=false
