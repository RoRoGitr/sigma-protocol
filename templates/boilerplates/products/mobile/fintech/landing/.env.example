# ─────────────────────────────────────────────────────────────────────────────
# Fintech Trading Platform — Landing Page Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Next.js automatically loads .env.local. Never commit it.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Keep any private API keys in non-prefixed variables (server-side only).
# ─────────────────────────────────────────────────────────────────────────────


# ─── Site URL ─────────────────────────────────────────────────────────────────
# The canonical public URL of the landing page.
# Used for Open Graph meta tags, canonical links, and absolute URLs.
# In production, set this to your deployed domain (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
