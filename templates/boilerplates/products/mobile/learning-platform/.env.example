# ─────────────────────────────────────────────────────────────────────────────
# Learning Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file with real secrets.
#
# Variables prefixed with EXPO_PUBLIC_ are bundled into the JS bundle and
# visible to the client. Do NOT put private keys in EXPO_PUBLIC_ variables.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Supabase (Authentication + Database) ────────────────────────────────────
# Create a free project at https://supabase.com
# Find these under: Project Settings → API → Project URL / anon (public) key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key


# ─── OpenAI (AI Tutor Chat + Whisper STT + TTS) ──────────────────────────────
# Sign up at https://platform.openai.com and create an API key.
# Dashboard → API Keys → Create new secret key
# Used for: GPT-4o-mini chat, Whisper speech-to-text, TTS audio generation.
# NOTE: Keep this server-side. Route API calls through a backend or Edge Function
# rather than calling OpenAI directly from the mobile client in production.
OPENAI_API_KEY=sk-your-openai-api-key


# ─── LiveKit (Live Video Tutoring) ───────────────────────────────────────────
# LiveKit enables real-time video calls for the tutor scheduling feature.
# Sign up at https://livekit.io (cloud plan available) or self-host.
# Get your API key/secret under Project → Settings → Keys.
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret
# The WebSocket URL for your LiveKit server (cloud or self-hosted).
EXPO_PUBLIC_LIVEKIT_SERVER_URL=wss://your-project.livekit.cloud


# ─── RevenueCat (Subscriptions — iOS + Android) ──────────────────────────────
# Sign up at https://www.revenuecat.com and create a project.
# Find keys under Project Settings → API Keys → Public app-specific key.
# Use separate keys per platform.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-revenuecat-ios-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-revenuecat-android-key


# ─── Expo Push Notifications ─────────────────────────────────────────────────
# Expo handles push notification delivery automatically.
# No extra key is required here — notifications use your Expo account
# credentials configured in eas.json. See: https://expo.dev/notifications
