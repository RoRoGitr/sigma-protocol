# =============================================================================
# Sigma Next.js AI Boilerplate — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# =============================================================================

# --- Convex (required) -------------------------------------------------------
# Your Convex deployment URL (from convex dashboard or `convex dev` output)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Your Convex deployment name (used by `convex deploy` in CI)
CONVEX_DEPLOYMENT=your-deployment-name

# --- OpenAI / Vercel AI SDK (required for AI chat) ---------------------------
# Your OpenAI API key — keep this server-side only (no NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=sk-your-openai-api-key

# Set to "true" to enable the AI chat UI (exposes non-secret flag to client)
NEXT_PUBLIC_HAS_OPENAI_KEY=true

# --- PostHog Analytics (optional) --------------------------------------------
# Your PostHog project API key
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key

# Your PostHog host (use https://app.posthog.com or self-hosted URL)
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Convex Auth (set automatically by convex dev) ---------------------------
# These are typically injected by the Convex CLI — do not set manually
# CONVEX_AUTH_PRIVATE_KEY=
# JWKS=
