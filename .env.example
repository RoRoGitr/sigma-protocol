# Content tooling skill pack - copy to .env and fill in
SUPADATA_API_KEY=<YOUR_SUPADATA_KEY_HERE>          # https://dash.supadata.ai
KIE_AI_API_KEY=<YOUR_KIE_AI_KEY_HERE>              # https://kie.ai/api-keys
SCRAPECREATORS_API_KEY=<YOUR_SCRAPECREATORS_KEY>   # https://scrapecreators.com (used by last30days plugin)
HEYGEN_API_KEY=<OPTIONAL_HEYGEN_TTS_KEY>           # only if using HeyGen TTS - Hyperframes itself needs no key
KIE_MONTHLY_LIMIT=50                                # USD cap on kie.ai spend per month (default $50)
